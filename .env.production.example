# Variables de la aplicacion (web y worker) para el despliegue con docker-compose.
# Copiar como ".env.production" en la VM y completar con valores reales.
# DATABASE_URL no va aqui: docker-compose.yml la arma sola con POSTGRES_PASSWORD.

AUTH_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"
ALLOW_PUBLIC_REGISTRATION="false"
APP_URL="https://tu-subdominio.duckdns.org"

RESEND_API_KEY=""
EMAIL_FROM="WildlifeAI <notificaciones@tu-dominio.com>"

META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_API_VERSION="v23.0"
META_WHATSAPP_TEMPLATE_LANGUAGE="es"
META_WHATSAPP_OTP_TEMPLATE_NAME="wildlifeai_otp"
META_WHATSAPP_OTP_BUTTON_SUBTYPE="copy_code"
META_WHATSAPP_BATCH_TEMPLATE_NAME="wildlifeai_batch_finished"

PYTHON_BIN="/opt/venv/bin/python"
YOLO_MODEL_PATH="yolov8n.pt"
CURATED_MODEL_ENABLED="true"
CURATED_MODEL_CONFIDENCE_THRESHOLD="55"
SPECIESNET_LOW_CONFIDENCE_THRESHOLD="60"

STORAGE_ROOT="/app/storage"
MAX_ZIP_SIZE_MB="2048"
MAX_ZIP_ENTRIES="20000"
MAX_UNCOMPRESSED_SIZE_MB="10240"
MAX_COMPRESSION_RATIO="100"
BATCH_STALE_MINUTES="15"
MAX_BATCH_ATTEMPTS="3"
WORKER_HEARTBEAT_SECONDS="10"
WORKER_ID=""
BATCH_WORKER_POLL_MS="5000"
BATCH_WORKER_STEP_WARN_MS="20000"

SPECIESNET_ENABLED="true"
SPECIESNET_COUNTRY="ECU"
SPECIESNET_TIMEOUT="300"
SPECIESNET_BATCH_SIZE="8"
PROGRESS_MICROBATCH_SIZE="1"
SPECIESNET_BATCH_TIMEOUT="0"
SPECIESNET_BATCH_TIMEOUT_MS="0"

MEGADETECTOR_ENABLED="true"
MEGADETECTOR_MODEL="MDV5A"
MEGADETECTOR_THRESHOLD="0.2"

ANALYSIS_MAX_IMAGE_DIMENSION="960"
INDIVIDUAL_MATCH_THRESHOLD="82"
INDIVIDUAL_MATCH_VISUAL_THRESHOLD="80"
INDIVIDUAL_MATCH_MAX_CANDIDATES="12"
TESSERACT_CMD="tesseract"
CAPTURE_DATE_FILENAME_FORMAT=""
CAPTURE_DATE_OCR_FORMAT="MDY"
